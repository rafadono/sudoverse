    "name": "SudoVerse",
    "slug": "sudoverse",
    "version": "0.2.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "icon": "./assets/icon.png",
    "backgroundColor": "#1e293b",
    "android": {
      "package": "io.github.rafadono.sudoverse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1e293b"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
